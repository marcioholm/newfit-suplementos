{
  "name": "New Fit Suplementos - Webhook Vendas Personal (Sheets + Evolution API)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "newfit-venda-personal",
        "options": {}
      },
      "id": "node-webhook-1",
      "name": "Webhook New Fit",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "newfit-venda-personal"
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "SEU_GOOGLE_SHEETS_ID_AQUI"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Vendas_Balcao"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "ID_Venda": "={{ $json.body.sale.id }}",
            "Data_Hora": "={{ $json.body.timestamp }}",
            "Personal_Nome": "={{ $json.body.personal.name }}",
            "Personal_Academia": "={{ $json.body.personal.gym }}",
            "Personal_Telefone": "={{ $json.body.personal.phone }}",
            "Aluno_Nome": "={{ $json.body.sale.clientName }}",
            "Valor_Venda": "={{ $json.body.sale.value }}",
            "Pontos_Gerados": "={{ $json.body.sale.pointsAdded }}",
            "Produtos": "={{ $json.body.sale.notes }}",
            "Ranking_Atual": "={{ $json.body.personal.currentRank }}",
            "Total_Pontos_Mes": "={{ $json.body.personal.currentMonthPoints }}"
          }
        },
        "options": {}
      },
      "id": "node-sheets-1",
      "name": "Gravar no Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [480, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.evolution.sua-instancia.com/message/sendText/sua-instancia",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "SUA_APIKEY_EVOLUTION_AQUI"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "number",
              "value": "={{ $json.body.personal.phone }}"
            },
            {
              "name": "text",
              "value": "={{ $json.body.whatsappMessagePreview }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-evolution-1",
      "name": "Disparar WhatsApp (Evolution API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 400]
    }
  ],
  "connections": {
    "Webhook New Fit": {
      "main": [
        [
          {
            "node": "Gravar no Google Sheets",
            "type": "main",
            "index": 0
          },
          {
            "node": "Disparar WhatsApp (Evolution API)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
