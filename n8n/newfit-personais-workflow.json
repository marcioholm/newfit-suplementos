      "id": "b1000000-0000-4000-8000-000000000006",
      "name": "Gravar Config",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        720,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "// Recebe { personais: [...] } (lote) ou { personal: {...} } (um só) e prepara as linhas da aba Personais\nconst body = $input.first().json.body || {};\nconst list = Array.isArray(body.personais) ? body.personais : body.personal ? [body.personal] : [];\nconst agora = DateTime.now().setZone('America/Sao_Paulo').toFormat('dd/MM/yyyy HH:mm:ss');\nconst txt = (v, max) => String(v ?? '').trim().slice(0, max);\n\nreturn list\n  .filter((p) => p && p.id && p.name)\n  .slice(0, 300)\n  .map((p) => {\n    const row = {\n      'ID': txt(p.id, 60),\n      'Nome': txt(p.name, 120),\n      'Primeiro Nome': txt(p.firstName || String(p.name).split(' ')[0], 60),\n      'Academia': txt(p.gym, 120),\n      'Cupom': txt(p.code, 30).toUpperCase(),\n      'Ativo': p.active === false ? 'não' : 'sim',\n      // Foto comprimida pelo app (data URL). Limite de célula do Sheets: 50 mil caracteres\n      'Foto': typeof p.avatarUrl === 'string' && p.avatarUrl.startsWith('data:image/') && p.avatarUrl.length < 45000 ? p.avatarUrl : '',\n      'Atualizado em': agora\n    };\n    // Aparelhos que baixaram o personal da planilha não têm o telefone: não apaga o que já está lá\n    const fone = String(p.phone ?? '').replace(/\\D/g, '').slice(0, 13);\n    if (fone) row['Telefone'] = fone;\n    return { json: row };\n  });\n"
      },
