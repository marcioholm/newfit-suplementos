    {
      "parameters": {
        "jsCode": "// Grava prêmios, mensagem predefinida e comissão na aba Config (Chave / Valor)\nconst body = $input.first().json.body || {};\nconst agora = DateTime.now().setZone('America/Sao_Paulo').toFormat('dd/MM/yyyy HH:mm:ss');\nconst rows = [];\n\nif (body.prizes && typeof body.prizes === 'object') {\n  rows.push({ json: { Chave: 'prizes', Valor: JSON.stringify(body.prizes), 'Atualizado em': agora } });\n}\nif (typeof body.whatsappTemplate === 'string') {\n  rows.push({ json: { Chave: 'whatsappTemplate', Valor: body.whatsappTemplate, 'Atualizado em': agora } });\n}\nif (typeof body.commissionRate === 'number' && !isNaN(body.commissionRate)) {\n  rows.push({ json: { Chave: 'commissionRate', Valor: String(body.commissionRate), 'Atualizado em': agora } });\n}\nif (typeof body.storeName === 'string' && body.storeName.trim()) {\n  rows.push({ json: { Chave: 'storeName', Valor: body.storeName.trim(), 'Atualizado em': agora } });\n}\n\nreturn rows;\n"
      },
